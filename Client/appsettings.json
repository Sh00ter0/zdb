{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Debug",
        "Discord": "Debug",
        "Client.Controllers": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://192.168.88.50:5090"
      }
    }
  },
  "discord": {
    "apiToken": ""
  },
  "api": {
    "headerName": "X-Api-Key",
    "databasePath": "Data/api-security.db",
    "apiKeyHashPepper": "",
    "allowInsecureHttp": true,
    "rateLimitPermit": 30,
    "rateLimitWindowSeconds": 60,
    "knownProxies": [],
    "masterEncryptionKey": ""
  }
}
